	measure 'Detalle min entre envios' = "mediana " & FORMAT ( [Min entre envios (mediana)], "0.0" ) & " min · 60+ min = otra sesión"
		displayFolder: 0 Inicio
		lineageTag: 74a4c470-c032-4713-842f-2e02a4086aee

	/// Pares entregados con mejor NotaReal < 55
	measure 'Pares desaprobados' = [Pares entregados] - [Pares aprobados]
		formatString: #,0
		displayFolder: 2 Entregas
		lineageTag: e50d7033-9c43-49fb-8586-84b9b27a507c

	/// Tarea obligatoria anterior (por Orden) del mismo curso, ruta y banda; vacio si no hay una sola tarea en el contexto
	measure 'Tarea anterior key' =
			VAR k = SELECTEDVALUE ( Tareas[TareaKey] )
			VAR o = SELECTEDVALUE ( Tareas[Orden] )
			VAR c = SELECTEDVALUE ( Tareas[Curso] )
			VAR r = SELECTEDVALUE ( Tareas[Ruta] )
			VAR b = SELECTEDVALUE ( Tareas[Banda] )
			RETURN
			    IF (
			        NOT ISBLANK ( k ),
			        MAXX (
			            TOPN (
			                1,
			                CALCULATETABLE (
			                    SUMMARIZE ( Tareas, Tareas[TareaKey], Tareas[Orden] ),
			                    REMOVEFILTERS ( Tareas ),
			                    Tareas[Curso] = c, Tareas[Ruta] = r, Tareas[Banda] = b,
			                    Tareas[CuentaParaEntrega] = TRUE (),
			                    Tareas[Orden] < o
			                ),
			                Tareas[Orden], DESC
			            ),
			            Tareas[TareaKey]
			        )
			    )
		isHidden
		displayFolder: 0 Inicio
		lineageTag: 513971d8-5887-4737-a441-43aa8a5f4398

	/// Puntos porcentuales de Aprobado s/ esperado contra la tarea anterior (solo con un notebook elegido)
	measure 'Aprobado vs anterior (pp)' =
			VAR prev = [Tarea anterior key]
			RETURN
			    IF (
			        NOT ISBLANK ( prev ) && SELECTEDVALUE ( Tareas[YaVencio] ) = TRUE (),
			        ( [Aprobado s/ esperado %] - CALCULATE ( [Aprobado s/ esperado %], REMOVEFILTERS ( Tareas ), Tareas[TareaKey] = prev ) ) * 100
			    )
		formatString: +0;-0;0
		displayFolder: 0 Inicio
		lineageTag: 77203725-bc6c-4ce6-b97c-1e3e7f35d886

	/// De los alumnos del padron que aprobaron la tarea anterior, % que aprueba esta (no entregar = no aprobar)
	measure 'Aprueba si aprobó el anterior %' =
			VAR k = SELECTEDVALUE ( Tareas[TareaKey] )
			VAR prev = [Tarea anterior key]
			VAR base = CALCULATETABLE ( VALUES ( Alumnos[StudentKey] ), Alumnos[Curso] = SELECTEDVALUE ( Tareas[Curso] ) )
			VAR aprobPrev = CALCULATETABLE ( VALUES ( AlumnoTarea[StudentKey] ), REMOVEFILTERS ( Tareas ), AlumnoTarea[TareaKey] = prev, AlumnoTarea[Estado] = "Aprobó" )
			VAR aprobK = CALCULATETABLE ( VALUES ( AlumnoTarea[StudentKey] ), REMOVEFILTERS ( Tareas ), AlumnoTarea[TareaKey] = k, AlumnoTarea[Estado] = "Aprobó" )
			VAR grupo = INTERSECT ( base, aprobPrev )
			RETURN
			    IF (
			        NOT ISBLANK ( prev ) && SELECTEDVALUE ( Tareas[YaVencio] ) = TRUE (),
			        DIVIDE ( COUNTROWS ( INTERSECT ( grupo, aprobK ) ), COUNTROWS ( grupo ) )
			    )
		formatString: 0%;-0%;0%
		displayFolder: 0 Inicio
		lineageTag: cb0eae44-3c23-4566-8652-06996d424a4a

	/// De los alumnos del padron que no aprobaron (o no entregaron) la tarea anterior, % que aprueba esta (no entregar = no aprobar)
	measure 'Aprueba si no aprobó el anterior %' =
			VAR k = SELECTEDVALUE ( Tareas[TareaKey] )
			VAR prev = [Tarea anterior key]
			VAR base = CALCULATETABLE ( VALUES ( Alumnos[StudentKey] ), Alumnos[Curso] = SELECTEDVALUE ( Tareas[Curso] ) )
			VAR aprobPrev = CALCULATETABLE ( VALUES ( AlumnoTarea[StudentKey] ), REMOVEFILTERS ( Tareas ), AlumnoTarea[TareaKey] = prev, AlumnoTarea[Estado] = "Aprobó" )
			VAR aprobK = CALCULATETABLE ( VALUES ( AlumnoTarea[StudentKey] ), REMOVEFILTERS ( Tareas ), AlumnoTarea[TareaKey] = k, AlumnoTarea[Estado] = "Aprobó" )
			VAR grupo = EXCEPT ( base, aprobPrev )
			RETURN
			    IF (
			        NOT ISBLANK ( prev ) && SELECTEDVALUE ( Tareas[YaVencio] ) = TRUE (),
			        DIVIDE ( COUNTROWS ( INTERSECT ( grupo, aprobK ) ), COUNTROWS ( grupo ) )
			    )
		formatString: 0%;-0%;0%
		displayFolder: 0 Inicio
		lineageTag: a61d4970-625f-47b4-b9a5-42659d59b915

	/// Tamano del grupo (tooltip)
	measure 'n aprobó el anterior' =
			VAR k = SELECTEDVALUE ( Tareas[TareaKey] )
			VAR prev = [Tarea anterior key]
			VAR base = CALCULATETABLE ( VALUES ( Alumnos[StudentKey] ), Alumnos[Curso] = SELECTEDVALUE ( Tareas[Curso] ) )
			VAR aprobPrev = CALCULATETABLE ( VALUES ( AlumnoTarea[StudentKey] ), REMOVEFILTERS ( Tareas ), AlumnoTarea[TareaKey] = prev, AlumnoTarea[Estado] = "Aprobó" )
			VAR aprobK = CALCULATETABLE ( VALUES ( AlumnoTarea[StudentKey] ), REMOVEFILTERS ( Tareas ), AlumnoTarea[TareaKey] = k, AlumnoTarea[Estado] = "Aprobó" )
			VAR grupo = INTERSECT ( base, aprobPrev )
			RETURN
			    IF (
			        NOT ISBLANK ( prev ) && SELECTEDVALUE ( Tareas[YaVencio] ) = TRUE (),
			        COUNTROWS ( grupo ) + 0
			    )
		formatString: #,0
		displayFolder: 0 Inicio
		lineageTag: 27e493b7-b297-4ed8-96fb-4dbf39a815ad

	/// Tamano del grupo (tooltip)
	measure 'n no aprobó el anterior' =
			VAR k = SELECTEDVALUE ( Tareas[TareaKey] )
			VAR prev = [Tarea anterior key]
			VAR base = CALCULATETABLE ( VALUES ( Alumnos[StudentKey] ), Alumnos[Curso] = SELECTEDVALUE ( Tareas[Curso] ) )
			VAR aprobPrev = CALCULATETABLE ( VALUES ( AlumnoTarea[StudentKey] ), REMOVEFILTERS ( Tareas ), AlumnoTarea[TareaKey] = prev, AlumnoTarea[Estado] = "Aprobó" )
			VAR aprobK = CALCULATETABLE ( VALUES ( AlumnoTarea[StudentKey] ), REMOVEFILTERS ( Tareas ), AlumnoTarea[TareaKey] = k, AlumnoTarea[Estado] = "Aprobó" )
			VAR grupo = EXCEPT ( base, aprobPrev )
			RETURN
			    IF (
			        NOT ISBLANK ( prev ) && SELECTEDVALUE ( Tareas[YaVencio] ) = TRUE (),
			        COUNTROWS ( grupo ) + 0
			    )
		formatString: #,0
		displayFolder: 0 Inicio
		lineageTag: 2cca13a6-f650-4f7c-bf56-74721d2eb295

	measure 'Detalle al salir de clase' =
			VAR d = ( [Aprobado s/ esperado %] - [Aprobado al salir de clase %] ) * 100
			RETURN IF ( NOT ISBLANK ( [Entregas esperadas] ), FORMAT ( d, "+0;-0;0" ) & " pp se ganan después de clase" )
		displayFolder: 0 Inicio
		lineageTag: c202f7bf-8446-4c08-9e77-ac86a4b6f97a

	measure 'Detalle fuera de clase' =
			VAR g = FILTER ( ADDCOLUMNS ( VALUES ( Alumnos[Grado] ), "@v", [Trabajó fuera de clase %] ), NOT ISBLANK ( [@v] ) )
			VAR low = TOPN ( 1, g, [@v], ASC, Alumnos[Grado], ASC )
			RETURN
			    IF (
			        COUNTROWS ( g ) > 1,
			        "más bajo: " & MAXX ( low, Alumnos[Grado] ) & " " & FORMAT ( MAXX ( low, [@v] ), "0%" ),
			        "sobre " & FORMAT ( [Pares entregados] + 0, "#,0" ) & " entregas"
			    )
		displayFolder: 0 Inicio
		lineageTag: d1b3cddb-4279-4ecf-89e1-9430ac8a5834

	measure 'Detalle en riesgo' = "de " & COUNTROWS ( Alumnos ) & " · prom. < 55 o entrega < 50%"
		displayFolder: 0 Inicio
		lineageTag: b6440632-2339-4b4c-8f4a-fc4059b24112

	measure 'Detalle sesiones' = "mediana " & FORMAT ( [Min entre envios (mediana)], "0.0" ) & " min entre envíos"
		displayFolder: 0 Inicio
		lineageTag: a810baaa-ccf0-40ab-8e83-3c254a6a0a58

	/// Dias desde el ultimo envio como texto; ⚠ si pasan 7 dias o nunca envio
	measure 'Ultima actividad' =
			VAR d = [Dias desde ultimo envio]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( d ), "⚠ nunca envió",
			        d > 7, "⚠ hace " & d & " días",
			        "hace " & d & IF ( d = 1, " día", " días" )
			    )
		displayFolder: 0 Inicio
		lineageTag: 7de46d50-85fb-4cf9-abd6-e134ccc8a6b7

	/// Celda de la lista de cotejo: icono + texto (el color solo acompana)
	measure Cotejo =
			SWITCH (
			    SELECTEDVALUE ( AlumnoIndicador[Cotejo] ),
			    "Sí", "✓ Sí",
			    "No", "✗ No",
			    "No entregó", "– No entregó",
			    "Pendiente", "… Pendiente",
			    "Sin desglose", "? Sin desglose"
			)
		displayFolder: 10 Cotejo
		lineageTag: 3c842378-f693-4e15-b9c6-5a922334fdcf

	measure 'Cotejo color' =
			VAR c = SELECTEDVALUE ( AlumnoIndicador[Cotejo] )
			RETURN
			    IF (
			        NOT ISBLANK ( c ),
			        SWITCH ( c, "Sí", "#8B5CF6", "No", "#DB6C14", "No entregó", "#6B6B76", "#2A2A33" )
			    )
		isHidden
		displayFolder: 10 Cotejo
		lineageTag: 00c20269-7953-4d4f-ab5f-3cb4186cb2da

	/// % de alumnos esperados (padron, tarea vencida) que logran el indicador; quien no entrego cuenta como No. Pendiente y Sin desglose no cuentan
	measure 'Indicador logrado %' =
			DIVIDE (
			    CALCULATE ( COUNTROWS ( AlumnoIndicador ), AlumnoIndicador[Cotejo] = "Sí" ) + 0,
			    CALCULATE ( COUNTROWS ( AlumnoIndicador ), AlumnoIndicador[Cotejo] IN { "Sí", "No", "No entregó" } )
			)
		formatString: 0%
		displayFolder: 10 Cotejo
		lineageTag: d22fbad2-53e5-4e04-a0be-9f200eac57c7

	/// "4 / 6": indicadores logrados sobre los evaluables en el contexto (por alumno)
	measure 'Indicadores logrados' =
			VAR si = CALCULATE ( COUNTROWS ( AlumnoIndicador ), AlumnoIndicador[Cotejo] = "Sí" ) + 0
			VAR tot = CALCULATE ( COUNTROWS ( AlumnoIndicador ), AlumnoIndicador[Cotejo] IN { "Sí", "No", "No entregó" } )
			RETURN IF ( tot > 0, si & " / " & tot )
		displayFolder: 10 Cotejo
		lineageTag: 3bab2b9c-7e14-4718-9a03-792a6b8874f8

	/// Logro promedio (puntos obtenidos / posibles) de las preguntas que evidencian el indicador, solo entre quienes entregaron
	measure 'Logro promedio' = AVERAGE ( AlumnoIndicador[Logro] )
		formatString: 0%
		displayFolder: 10 Cotejo
		lineageTag: a332c733-16e7-47a2-8b3a-f1a4ab163465

	/// Checks de lista de cotejo agrupados (alumno x indicador) con mapeo claro y evaluables: Sí, No o No entregó. Pendiente y Sin desglose no cuentan
	measure 'Cotejos n' =
			CALCULATE (
			    COUNTROWS ( AlumnoIndicador ),
			    AlumnoIndicador[Cotejo] IN { "Sí", "No", "No entregó" },
			    Indicadores[MapeoClaro] = TRUE ()
			)
		formatString: #,0
		displayFolder: 11 Nivel de logro
		lineageTag: 8f9d6adb-f17e-43e6-a7f0-a9087d1e700b

	measure 'Cotejos Sí %' =
			DIVIDE (
			    CALCULATE ( COUNTROWS ( AlumnoIndicador ), AlumnoIndicador[Cotejo] = "Sí", Indicadores[MapeoClaro] = TRUE () ) + 0,
			    [Cotejos n]
			)
		formatString: 0%
		displayFolder: 11 Nivel de logro
		lineageTag: 8c9caee3-d942-4878-a6d7-d0c3507b66fe

	/// Escala CNB sobre % Sí de los checks agrupados: C < 50%, B 50% a < 70%, A 70% a < 90%, AD >= 90%. Mismos cortes que la tabla Niveles
	measure 'Nivel de logro' =
			VAR n = [Cotejos n]
			VAR p = [Cotejos Sí %]
			RETURN
			    IF ( n > 0, SWITCH ( TRUE (), p >= 0.9, "AD", p >= 0.7, "A", p >= 0.5, "B", "C" ) )
		displayFolder: 11 Nivel de logro
		lineageTag: b89fc8d5-336d-4af8-ac14-822ec7d40bff

	/// "A · 78% (n=22)"
	measure 'Nivel de logro detalle' =
			VAR l = [Nivel de logro]
			RETURN IF ( NOT ISBLANK ( l ), l & " · " & FORMAT ( [Cotejos Sí %], "0%" ) & " (n=" & [Cotejos n] & ")" )
		displayFolder: 11 Nivel de logro
		lineageTag: 7e896077-8840-4a3b-8413-807f28185813

	measure 'Nivel color' = SWITCH ( [Nivel de logro], "AD", "#7C3AED", "A", "#4F46A5", "B", "#B45309", "C", "#DB6C14" )
		isHidden
		displayFolder: 11 Nivel de logro
		lineageTag: ccc2c037-8a0e-4b54-8c60-328d4480b8ed

	/// Alumnos cuyo nivel de logro (en el contexto: capacidad, competencia, grado) es el nivel de Niveles seleccionado
	measure 'Alumnos en nivel' =
			VAR lv = SELECTEDVALUE ( Niveles[Nivel] )
			RETURN COUNTROWS ( FILTER ( VALUES ( Alumnos[StudentKey] ), [Nivel de logro] = lv ) )
		formatString: #,0
		displayFolder: 11 Nivel de logro
		lineageTag: f8d7da8f-7a02-4d46-9421-7a349727d89e

	column _
		dataType: string
		isHidden
		lineageTag: 1e669d49-12ae-4338-9937-4bc704e6d17b
		summarizeBy: none
		sourceColumn: [_]

	partition _Medidas = calculated
		mode: import
		source = ROW ( "_", "" )

